{
    "sqldeveloper.sqlHistory.historyLimit": 500,
    "chat.commandCenter.enabled": false,
    "sqldeveloper.plsqlDebugger.lowerPortNumber": 49159,
    "sqldeveloper.plsqlDebugger.upperPortNumber": 49160,
    "sqldeveloper.telemetry.enabled": true,
    "[oraclesql]": {
        "editor.suggest.showSnippets": true,
        "editor.quickSuggestions": {
            "comments": "on",
            "strings": "on",
            "other": "on"
        }
    },
    "[oracle]": {
        "files.autoSaveWorkspaceFilesOnly": true,
        "files.autoSaveWhenNoErrors": true
    },
    "files.associations": {
        "*.typ": "oracle-sql",
        "*.prc": "oracle-sql",
        "*.sql": "oracle-sql",
        "*.pck": "oracle-sql"
    },
    "[oracle-sql]": {
        "files.encoding": "windows1251"

    },
    //"oracledevtools.connectionConfiguration.walletFileFolder": "/home/gzheyts/Oracle/network/admin",
    //"oracledevtools.bookmarkFileFolder": "/home/gzheyts/Oracle/oracle.oracledevtools",
    //"oracledevtools.download.otherFolder": "/home/gzheyts/downloads",
    "oracledevtools.connections": [
        {
            "authenticationType": 1,
            "dBAPrivilege": "SYSDBA",
            "userID": "SYS",
            "passwordSaved": true,
            "dataSource": "localhost:1523/xe",
            "connectionType": 2,
            "databaseHostName": "localhost",
            "databasePortNumber": "1523",
            "databaseServiceName": "xe",
            "name": "sys@local-21-debug",
            "color": "none",
            "currentSchema": "",
            "addSettingsScopeToConnectionName": false,
            "addCurrentSchemaToConnectionName": false,
            "filters": [],
            "useCompatibleNamesDirectoryPath": true,
            "passwordStore": "Secret Storage"
        }
    ],
    "editor.minimap.enabled": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "window.zoomLevel": 1.0455173977264463,
    "files.autoSave": "afterDelay",
    "java.completion.filteredTypes": [
        "java.awt.*",
        "com.sun.*",
        "sun.*",
        "jdk.*",
        "org.graalvm.*",
        "io.micrometer.shaded.*"
    ],
    "editor.lineNumbers": "relative",
    // workbench settings
    "workbench.editor.preferHistoryBasedLanguageDetection": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "terminal.integrated.stickyScroll.enabled": true,
    // cursor && window
    "window.commandCenter": true,
    "window.customTitleBarVisibility": "auto",
    "workbench.editor.closeOnFileDelete": true,
    "workbench.productIconTheme": "jetbrans",
    "workbench.iconTheme": "pcode-icon-theme-jetbrains",
    "telemetry.feedback.enabled": false,
    "update.releaseTrack": "prerelease",
    "[shellscript]": {
        "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
    },
    "window.autoDetectColorScheme": true,
    "chat.editor.fontSize": 18,
    "files.autoSaveWhenNoErrors": true,
    "editor.fontSize": 15,
    "explorer.confirmDelete": false,
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "explorer.confirmDragAndDrop": false,
    "docker.extension.enableComposeLanguageServer": false,
    // vim configuration
    "vim.easymotion": true,
    "vim.leader": ",",
    "vim.hlsearch": true,
    "vim.useSystemClipboard": true,
    "vim.handleKeys": {
        "<C-f>": true,
        "<C-b>": true,
        "<C-d>": true,
        "<C-v>": true,
        "<C-u>": true,
        "<C-w>": true,
        "<C-z>": false
    },
    "vim.normalModeKeyBindingsNonRecursive": [

        // splits
        {
            "before": [ "leader", "v" ],
            "commands": [ ":vsplit" ]
        },
        {
            "before": [ "leader", "s" ],
            "commands": [ ":split" ],
        },
        // panes
        {
            "before": [ "leader", "h" ],
            "commands": [ "workbench.action.focusLeftGroup" ]
        },
        {
            "before": [ "leader", "j" ],
            "commands": [ "workbench.action.focusBelowGroup" ]
        },
        {
            "before": [ "leader", "k" ],
            "commands": [ "workbench.action.focusAboveGroup" ]
        },
        {
            "before": [ "leader", "l" ],
            "commands": [ "workbench.action.focusRightGroup" ]
        },
        // NICE TO HAVE
        {
            "before": [ "leader", "w" ],
            "commands": [ "workbench.action.moveEditorGroupToNewWindow" ]
        },
        {
            "before": [ "leader", "q" ],
            "commands": [ ":q!" ]
        },
        {
            "before": [ "leader", "x" ],
            "commands": [ ":x!" ]
        },
        {
            "before": [ "[", "d" ],
            "commands": [ "editor.action.marker.prev" ]
        },
        {
            "before": [ "]", "d" ],
            "commands": [ "editor.action.marker.next" ]
        },
        {
            "before": [ "]", "c" ],
            "commands": [ "editor.action.dirtydiff.next" ]
        },
        {
            "before": [ "leader", "n", "l" ],
            "commands": [ "workbench.files.action.showActiveFileInExplorer" ]
        },
        {
            "before": [ "[", "c" ],
            "commands": [ "editor.action.dirtydiff.previous" ]
        },
        {
            "before": [ "leader", "f" ],
            "commands": [ "workbench.action.quickOpen" ]
        },
        {
            "before": [ "g", "h"],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ]
        },
        {
            "before": [ "]", "t", "d"],
            "commands": [ "editor.action.goToTypeDefinition" ]
        },
        {
            "before": [ "]", "s", "m"],
            "commands": [ "java.action.navigateToSuperImplementation" ]
        },
        {
            "before": [ "]", "i"],
            "commands": [ "editor.action.goToImplementation" ]
        },
        {
            "before": [ "g", ";"],
            "commands": [ "workbench.action.navigateBackInEditLocations" ]
        },
        {
            "before": [ "g", ","],
            "commands": [ "workbench.action.navigateForwardInEditLocations" ]
        },
        { "before": ["ё"], "after": ["`"] },
        { "before": ["й"], "after": ["q"] },
        { "before": ["ц"], "after": ["w"] },
        { "before": ["у"], "after": ["e"] },
        { "before": ["к"], "after": ["r"] },
