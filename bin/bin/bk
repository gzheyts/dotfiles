#!/bin/sh
# bk [-h|--help] [<source>] [-p|--path <target>]
# Backup a file or directory (copy) with a timestamped name.

set -eu

usage() {
	cat <<'EOF'
Usage: bk [-h|--help] [<source>] [-p|--path <target>]

Create a timestamped backup copy of a file or directory.

  -h, --help           Show this help
  <source>             File or directory to back up (default: current directory)
  -p, --path <target>  Destination directory for the backup

Defaults:
  no args              backup cwd into ../
  <source> only        backup <source> into cwd
  <source> -p <target> backup <source> into <target>
EOF
}

source=""
target=""
has_source=0
has_path=0

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	-p | --path)
		if [ $# -lt 2 ]; then
			echo "bk: -p/--path requires a directory argument" >&2
			exit 1
		fi
		target=$2
		has_path=1
		shift 2
		;;
	-*)
		echo "bk: unknown option: $1" >&2
		usage >&2
		exit 1
		;;
	*)
		if [ "$has_source" -eq 1 ]; then
			echo "bk: unexpected argument: $1" >&2
			usage >&2
			exit 1
		fi
		source=$1
		has_source=1
		shift
		;;
	esac
done

if [ "$has_source" -eq 0 ]; then
	source=.
fi

if [ "$has_path" -eq 0 ]; then
	if [ "$has_source" -eq 0 ]; then
		target=..
	else
		target=.
	fi
fi

if [ ! -e "$source" ]; then
	echo "bk: source does not exist: $source" >&2
	exit 1
fi

if [ ! -d "$target" ]; then
	echo "bk: target is not a directory: $target" >&2
	exit 1
fi

# Prefer real name for "." / ".."; files use basename as-is
if [ -d "$source" ]; then
	base=$(basename -- "$(cd -- "$source" && pwd -P)")
else
	base=$(basename -- "$source")
fi
stamp=$(date +"%d.%m.%Y_%H.%M.%S")
dest="$target/${base}-backup-${stamp}"

echo "backup: $source -> $dest"
cp -a -- "$source" "$dest"
