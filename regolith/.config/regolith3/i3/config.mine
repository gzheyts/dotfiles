# vim: set filetype=i3:

###############################################################################
# Meta Key Mappings
###############################################################################

# Meta Key - Alt key is Mod1, and Windows key is Mod4
set $mod Mod4
set $alt Mod1

set $up    k
set $down  j
set $left  h
set $right l

# default is gnome-control-center
set $control_center regolith-control-center

# scratchpad
set_from_resource $scratchpad_size i3wm.scratchpad_size 1920 1000

###############################################################################
# Workspace Names
# These are the labels which define each workspace.
###############################################################################

set_from_resource $tag1  wm.workspace.01.name "1"
set_from_resource $tag2  wm.workspace.02.name "2"
set_from_resource $tag3  wm.workspace.03.name "3"
set_from_resource $tag4  wm.workspace.04.name "4"
set_from_resource $tag5  wm.workspace.05.name "5"
set_from_resource $tag6  wm.workspace.06.name "6"
set_from_resource $tag7  wm.workspace.07.name "7"
set_from_resource $tag8  wm.workspace.08.name "8"
set_from_resource $tag9  wm.workspace.09.name "9"
set_from_resource $tag10 wm.workspace.10.name "10"
set $tagD	"d"
set $tagU 	""
set $tagY	"y"
set_from_resource $tag11 wm.workspace.11.name "11"
set_from_resource $tag12 wm.workspace.12.name "12"
set_from_resource $tag13 wm.workspace.13.name "13"
set_from_resource $tag14 wm.workspace.14.name "14"
set_from_resource $tag15 wm.workspace.15.name "15"
set_from_resource $tag16 wm.workspace.16.name "16"
set_from_resource $tag17 wm.workspace.17.name "17"
set_from_resource $tag18 wm.workspace.18.name "18"
set_from_resource $tag19 wm.workspace.19.name "19"

###############################################################################
# Workspace Keys
# These are the keys which will be used while binding workspace switching
###############################################################################

set_from_resource $tag1_key  wm.workspace.01.key 1
set_from_resource $tag2_key  wm.workspace.02.key 2
set_from_resource $tag3_key  wm.workspace.03.key 3
set_from_resource $tag4_key  wm.workspace.04.key 4
set_from_resource $tag5_key  wm.workspace.05.key 5
set_from_resource $tag6_key  wm.workspace.06.key 6
set_from_resource $tag7_key  wm.workspace.07.key 7
set_from_resource $tag8_key  wm.workspace.08.key 8
set_from_resource $tag9_key  wm.workspace.09.key 9
set_from_resource $tag10_key wm.workspace.10.key 0
set_from_resource $tag_high_key wm.workspace.high.key Ctrl


# Sets wm font for dialogs
set_from_resource $wm.font gtk.font_name Sans 13
font pango:$wm.font

###############################################################################
# i3 Config Partials
###############################################################################

# Lock screen

bindsym $mod+Ctrl+$right exec --no-startup-id xdg-screensaver lock
# Touchpad
bindsym $mod+comma exec --no-startup-id /usr/bin/touchpad-indicator -c

bindsym $mod+space 	focus mode_toggle
bindsym $mod+Shift+space sticky toggle

###############################################################################
# Launcher dialogs
###############################################################################

bindsym $mod+Return exec --no-startup-id /usr/bin/x-terminal-emulator

bindsym $mod+Shift+Return exec --no-startup-id gtk-launch $(xdg-settings get default-web-browser)


###############################################################################
# Window and Workspace Navigation
###############################################################################

bindsym $mod+a          focus parent
bindsym $mod+Shift+a 	focus child

bindsym $mod+bracketright focus next
bindsym $mod+bracketleft  focus prev

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

## Navigate // Workspaces 1-10 // <> 0..9 ##
bindsym $mod+1 workspace number $tag1
bindsym $mod+2 workspace number $tag2
bindsym $mod+3 workspace number $tag3
bindsym $mod+4 workspace number $tag4
bindsym $mod+5 workspace number $tag5
bindsym $mod+6 workspace number $tag6
bindsym $mod+7 workspace number $tag7
bindsym $mod+8 workspace number $tag8
bindsym $mod+9 workspace number $tag9
bindsym $mod+0 workspace number $tag10
bindsym $mod+y workspace $tagY
bindsym $mod+d workspace $tagD
bindsym $mod+u workspace $tagU
## Navigate // Workspace 11 - 19 // <><Ctrl> 1..9 ##
bindsym $mod+Ctrl+1 workspace number $tag11
bindsym $mod+Ctrl+2 workspace number $tag12
bindsym $mod+Ctrl+3 workspace number $tag13
bindsym $mod+Ctrl+4 workspace number $tag14
bindsym $mod+Ctrl+5 workspace number $tag15
bindsym $mod+Ctrl+6 workspace number $tag16
bindsym $mod+Ctrl+7 workspace number $tag17
bindsym $mod+Ctrl+8 workspace number $tag18
bindsym $mod+Ctrl+9 workspace number $tag19

###############################################################################
# i3-gaps Window Resize
###############################################################################


# Specify the distance between windows in pixels. (i3-gaps)
set_from_resource $gaps_default_inner wm.gaps.inner.size 10
set_from_resource $gaps_default_outer wm.gaps.outer.size 5

gaps inner $gaps_default_inner
gaps outer $gaps_default_outer


# Only enable gaps on a workspace when there is at least one container
smart_gaps on

set $mode_gaps gaps
set $mode_gaps_outer outer gaps
set $mode_gaps_inner inner gaps
bindsym $mod+Shift+g mode "$mode_gaps"
mode "$mode_gaps" {
    bindsym o      mode "$mode_gaps_outer"
    bindsym i      mode "$mode_gaps_inner"

    bindsym 0      mode "default", exec --no-startup-id i3-msg "gaps inner current set 0" && i3-msg "gaps outer current set 0"
    bindsym d      mode "default", exec --no-startup-id i3-msg "gaps inner current set $gaps_default_inner" && i3-msg "gaps outer current set $gaps_default_outer"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

mode "$mode_gaps_inner" {
    bindsym plus  gaps inner current plus 5
    bindsym minus gaps inner current minus 5
    bindsym 0     mode "default", gaps inner current set 0
    bindsym d     mode "default", gaps inner current set $gaps_default_inner

    bindsym Shift+plus  gaps inner all plus 5
    bindsym Shift+minus gaps inner all minus 5
    bindsym Shift+0     mode "default", gaps inner all set 0
    bindsym Shift+d     mode "default", gaps inner all set $gaps_default_inner

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

mode "$mode_gaps_outer" {
    bindsym plus  gaps outer current plus 5
    bindsym minus gaps outer current minus 5
    bindsym 0     mode "default", gaps outer current set 0
    bindsym d     mode "default", gaps outer current set $gaps_default_outer

    bindsym Shift+plus  gaps outer all plus 5
    bindsym Shift+minus gaps outer all minus 5
    bindsym Shift+0     mode "default", gaps outer all set 0
    bindsym Shift+d     mode "default", gaps outer all set $gaps_default_outer

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Provide window class to float above tiled windows
floating_maximum_size -1 x -1
for_window [class="floating_window"] floating enable
for_window [class="gnome-control-center"] floating enable

for_window [title="win.*"] floating enable
for_window [instance="telegram-desktop"] floating enable
for_window [class="Gnome-pomodoro"]  floating enable 
for_window [class="Gnome-calendar"]  floating enable 
for_window [class="zoom"]  floating enable 
for_window [class="copyq"]  floating enable 
for_window [class="Variety"]  floating enable 
for_window [instance="Places"]  floating enable 
for_window [instance="stacer"]  floating enable 
for_window [instance="gnome-tweaks"]  floating enable 

for_window [class=".*-control-center$"] floating enable
for_window [class=".*Remmina$"] floating enable
for_window [class="crow-translate"] floating enable

for_window [all] border pixel $wm.window.border.size
for_window [all] title_window_icon off

for_window [instance="scratchpad"] move to scratchpad, resize set $scratchpad_size, move absolute position 0 0

# Set titlebar mode
set_from_resource $wm.floatingwindow.border.size wm.floatingwindow.border.size 1
default_floating_border normal $wm.floatingwindow.border.size

set_from_resource $wm.window.border.size wm.window.border.size 1
default_border pixel $wm.window.border.size

bindsym $mod+b border toggle

# Enable popup during fullscreen
popup_during_fullscreen smart

# Don't focus window upon opening
no_focus [window_role="pop-up"]
for_window [window_role=PictureInPicture] sticky enable

# The window will always be marked urgent, but the focus will not be stolen
focus_on_window_activation urgent

focus_wrapping force

show_marks yes

mouse_warping output
# focus_follows_mouse yes|no
focus_follows_mouse no

# Hiding borders adjacent to the screen edges.
hide_edge_borders smart
## Navigate // Next Free Workspace // <> ` ##
bindsym $mod+grave exec --no-startup-id /usr/bin/i3-next-workspace

## Modify // Move Window to Next Free Workspace // <><Shift> ` ##
bindsym $mod+Shift+grave exec --no-startup-id /usr/bin/i3-next-workspace --move-window

## Modify // Carry Window to Next Free Workspace // <><Alt> ` ##
bindsym $mod+$alt+grave exec --no-startup-id /usr/bin/i3-next-workspace --move-window-and-follow
###############################################################################
# Window and Workspace Configuration
###############################################################################

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Ctrl+Shift+Left move workspace to output left
bindsym $mod+Ctrl+Shift+Right move workspace to output right
bindsym $mod+Ctrl+Shift+Up move workspace to output up
bindsym $mod+Ctrl+Shift+Down move workspace to output down

bindsym $mod+Ctrl+Shift+$left move workspace to output left
bindsym $mod+Ctrl+Shift+$down move workspace to output down
bindsym $mod+Ctrl+Shift+$up move workspace to output up
bindsym $mod+Ctrl+Shift+$right move workspace to output right


# split in horizontal orientation
bindsym $mod+semicolon split h

# split in vertical orientation
bindsym $mod+v split v

bindsym $mod+BackSpace split toggle

bindsym $mod+f fullscreen toggle
# toggle tiling / floating
bindsym $mod+Shift+f floating toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+t layout toggle tabbed splith splitv stacking


## Scratchpad
bindsym $mod+o scratchpad show
bindsym $mod+Shift+o move to scratchpad


## Modify // Move Window to Workspace 1 - 10 // <><Shift> 0..9 ##
bindsym $mod+Shift+1 move container to workspace number $tag1
bindsym $mod+Shift+2 move container to workspace number $tag2
bindsym $mod+Shift+3 move container to workspace number $tag3
bindsym $mod+Shift+4 move container to workspace number $tag4
bindsym $mod+Shift+5 move container to workspace number $tag5
bindsym $mod+Shift+6 move container to workspace number $tag6
bindsym $mod+Shift+7 move container to workspace number $tag7
bindsym $mod+Shift+8 move container to workspace number $tag8
bindsym $mod+Shift+9 move container to workspace number $tag9
bindsym $mod+Shift+0 move container to workspace number $tag10
bindsym $mod+Shift+y move container to workspace $tagY
bindsym $mod+Shift+d move container to workspace $tagD
bindsym $mod+Shift+u move container to workspace $tagU
## Modify // Move Window to Workspace 11 - 19// <><Ctrl><Shift> 1..9 ##
bindsym $mod+Shift+Ctrl+1 move container to workspace number $tag11
bindsym $mod+Shift+Ctrl+2 move container to workspace number $tag12
bindsym $mod+Shift+Ctrl+3 move container to workspace number $tag13
bindsym $mod+Shift+Ctrl+4 move container to workspace number $tag14
bindsym $mod+Shift+Ctrl+5 move container to workspace number $tag15
bindsym $mod+Shift+Ctrl+6 move container to workspace number $tag16
bindsym $mod+Shift+Ctrl+7 move container to workspace number $tag17
bindsym $mod+Shift+Ctrl+8 move container to workspace number $tag18
bindsym $mod+Shift+Ctrl+9 move container to workspace number $tag19

# move focused container to workspace, move to workspace
## Modify // Carry Window to Workspace 1 - 10// <><Alt> 0..9 ##
bindsym $mod+$alt+1 move container to workspace number $tag1; workspace number $tag1
bindsym $mod+$alt+2 move container to workspace number $tag2; workspace number $tag2
bindsym $mod+$alt+3 move container to workspace number $tag3; workspace number $tag3
bindsym $mod+$alt+4 move container to workspace number $tag4; workspace number $tag4
bindsym $mod+$alt+5 move container to workspace number $tag5; workspace number $tag5
bindsym $mod+$alt+6 move container to workspace number $tag6; workspace number $tag6
bindsym $mod+$alt+7 move container to workspace number $tag7; workspace number $tag7
bindsym $mod+$alt+8 move container to workspace number $tag8; workspace number $tag8
bindsym $mod+$alt+9 move container to workspace number $tag9; workspace number $tag9
bindsym $mod+$alt+0 move container to workspace number $tag10; workspace number $tag10
## Modify // Carry Window to Workspace 11 - 19 // <><Alt><Ctrl> 1..9 ##
bindsym $mod+$alt+Ctrl+1 move container to workspace number $tag11; workspace number $tag11
bindsym $mod+$alt+Ctrl+2 move container to workspace number $tag12; workspace number $tag12
bindsym $mod+$alt+Ctrl+3 move container to workspace number $tag13; workspace number $tag13
bindsym $mod+$alt+Ctrl+4 move container to workspace number $tag14; workspace number $tag14
bindsym $mod+$alt+Ctrl+5 move container to workspace number $tag15; workspace number $tag15
bindsym $mod+$alt+Ctrl+6 move container to workspace number $tag16; workspace number $tag16
bindsym $mod+$alt+Ctrl+7 move container to workspace number $tag17; workspace number $tag17
bindsym $mod+$alt+Ctrl+8 move container to workspace number $tag18; workspace number $tag18
bindsym $mod+$alt+Ctrl+9 move container to workspace number $tag19; workspace number $tag19

# automatic back-and-forth when switching to the current workspace
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth

force_display_urgency_hint 600 ms

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

###############################################################################
# Window Resize 
###############################################################################

# resizing {{{
# resize window (you can also use the mouse for that)
set $resize_inc 6
set $resize_inc_big 12

set $mode-resize " resize"
mode $mode-resize {
        # These bindings trigger as soon as you enter the resize mode
        bindsym $left 	resize shrink 	width 	$resize_inc px or $resize_inc ppt
        bindsym $down 	resize grow 	height 	$resize_inc px or $resize_inc ppt
        bindsym $up 	resize shrink 	height 	$resize_inc px or $resize_inc ppt
        bindsym $right 	resize grow 	width 	$resize_inc px or $resize_inc ppt

        bindsym Shift+$left 	resize shrink 	width 	$resize_inc_big px or $resize_inc_big ppt
        bindsym Shift+$down 	resize grow 	height 	$resize_inc_big px or $resize_inc_big ppt
        bindsym Shift+$up 	resize shrink 	height 	$resize_inc_big px or $resize_inc_big ppt
        bindsym Shift+$right 	resize grow 	width 	$resize_inc_big px or $resize_inc_big ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode $mode-resize
# }}}

set $mode-jump " jump"

mode $mode-jump {
# hardcoded focus keybindings
bindsym f [class="firefox"] focus; mode "default"
bindsym j [class="Joplin"] focus; mode "default"
bindsym q [class="qBittorrent"] focus; mode "default"
bindsym e [class="Evince"] focus; mode "default"
bindsym y [class="Yandex-browser-beta"] focus; mode "default"
bindsym t [class="TelegramDesktop"] focus; mode "default"
bindsym Shift+t [class="Gnome-Tweaks"] focus; mode "default"
bindsym Shift+a [class="Archi"] focus; mode "default"
bindsym s [class="Mattermost"] focus; mode "default"
bindsym z [class="zoom"] focus; mode "default"
bindsym Shift+s [class="install4j-com-eviware-soapui-SoapUI"] focus; mode "default"
bindsym Shift+t [instance="gnome-tweaks"] focus; mode "default"
# bindsym s [class="Slack"] focus; mode "default"
bindsym Shift+m [class="thunderbird"] focus; mode "default"
bindsym Shift+d [class="draw.io"] focus; mode "default"
bindsym d [class="DBeaver"] focus; mode "default"
bindsym a [class="Apache Directory Studio"] focus; mode "default"
bindsym i [class="jetbrains-idea"] focus; mode "default"
bindsym z [class="Zathura"] focus; mode "default"
bindsym Shift+z [class="zoom"] focus; mode "default"
bindsym Shift+s [class="Shutter"] focus; mode "default"
bindsym d [class="Zeal"] focus; mode "default"
bindsym c [instance="cursor"] focus; mode "default"
bindsym p [instance="gnome-pomodoro"] focus; mode "default"
bindsym Shift+v [instance="vlc"] focus; mode "default"
bindsym v [instance="code"] focus; mode "default"
bindsym Shift+o [instance="postman"] focus; mode "default"
bindsym o [title="Oracle SQL Developer.*"] focus; mode "default"

bindsym r [class="org.remmina.Remmina"] focus; mode "default"

bindsym l      workspace next_on_output; mode "default"
bindsym Ctrl+i workspace next; mode "default"
bindsym Ctrl+o workspace prev; mode "default"
bindsym h      workspace prev_on_output; mode "default"

bindsym Shift+1 mark mark1; mode "default"
bindsym Shift+2 mark mark2; mode "default"
bindsym Shift+3 mark mark3; mode "default"
bindsym Shift+4 mark mark4; mode "default"
bindsym Shift+5 mark mark5; mode "default"
bindsym Shift+6 mark mark6; mode "default"

bindsym 1 [con_mark="mark1"] focus; mode "default"
bindsym 2 [con_mark="mark2"] focus; mode "default"
bindsym 3 [con_mark="mark3"] focus; mode "default"
bindsym 4 [con_mark="mark4"] focus; mode "default"
bindsym 5 [con_mark="mark5"] focus; mode "default"
bindsym 6 [con_mark="mark6"] focus; mode "default"

bindsym Return mode "default"
bindsym Escape mode "default"
}

bindsym $mod+n mode $mode-jump

# launch {{{
set $mode-launch " launch"
mode $mode-launch {
    bindsym i mode "default", exec --no-startup-id idea
    bindsym t mode "default", exec --no-startup-id telegram-desktop
    bindsym j mode "default", exec --no-startup-id joplin-desktop
    bindsym Shift+t mode "default", exec --no-startup-id gnome-tweaks
    bindsym Shift+a mode "default", exec Archi
    bindsym d mode "default", exec --no-startup-id dbeaver-ce
    bindsym Shift+d mode "default", exec drawio
    bindsym e mode "default", exec --no-startup-id evince
    bindsym a mode "default", exec --no-startup-id apacheds
    bindsym o mode "default", exec --no-startup-id sqldeveloper
    bindsym s mode "default", exec --no-startup-id mattermost-desktop
    bindsym z mode "default", exec --no-startup-id zoom
    bindsym Shift+s mode "default", exec SoapUI-5.7.0
    bindsym Shift+t mode "default", exec gnome-tweaks
    bindsym f mode "default", exec --no-startup-id firefox
    bindsym Shift+c mode "default", exec gnome-calendar
    bindsym c mode "default", exec --no-startup-id cursor editor
    bindsym Shift+m mode "default", exec thunderbiro
    bindsym y mode "default", exec --no-startup-id yandex-browser-beta
    bindsym r mode "default", exec --no-startup-id remmina
    bindsym z mode "default", exec --no-startup-id zathura
    bindsym Shift+z mode "default", exec --no-startup-id zoom
    bindsym d mode "default", exec --no-startup-id zeal
    bindsym p mode "default", exec --no-startup-id gnome-pomodoro
    bindsym q mode "default", exec --no-startup-id qbittorrent
    bindsym Shift+o mode "default", exec --no-startup-id Postman

    bindsym $alt+c mode "default", exec --no-startup-id $control_center
    bindsym $alt+d mode "default", exec --no-startup-id $control_center display
    bindsym $alt+n mode "default", exec --no-startup-id $control_center network
    bindsym $alt+w mode "default", exec --no-startup-id $control_center wifi
    bindsym $alt+b mode "default", exec --no-startup-id $control_center bluetooth
    bindsym $alt+s mode "default", exec --no-startup-id $control_center sound

    bindsym Shift+v mode "default", exec --no-startup-id vlc
    bindsym v mode "default",       exec --no-startup-id code
    bindsym shift+t mode "default", exec --no-startup-id tomighty
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+period mode $mode-launch

###############################################################################
# launcher config
###############################################################################

set_from_resource $rofiTheme rofi.theme /usr/share/rofi/themes/Arc-Dark.rasi
bindsym $mod+backslash exec --no-startup-id rofi -show window -matching fuzzy  -theme ~/.config/rofi/theme/window.rasi

bindsym $mod+Ctrl+Shift+p exec --no-startup-id ~/.config/rofi/scripts/powermenu.sh

bindsym $mod+Shift+period exec --no-startup-id rofi -show drun -matching fuzzy -theme ~/.config/rofi/theme/launch.rasi
# Load stylesheet if exists
set_from_resource $ilia.stylesheet ilia.stylesheet

## Command
set_from_resource $wm.program.launcher.cmd wm.program.launcher.cmd ilia -p terminal
bindsym $mod+Ctrl+Shift+space exec --no-startup-id $wm.program.launcher.cmd -t $ilia.stylesheet

## Keybinding Viewer
set_from_resource $wm.program.help wm.program.help ilia -p keybindings
bindsym $mod+Shift+question exec --no-startup-id $wm.program.help -a -t $ilia.stylesheet

## Window by Name
set_from_resource $wm.program.launcher.window wm.program.launcher.window ilia -p windows
bindsym $mod+Ctrl+space exec --no-startup-id $wm.program.launcher.window -t $ilia.stylesheet

## File Search
set_from_resource $wm.program.file_search wm.program.file_search ilia -p tracker
bindsym $mod+Shift+Ctrl+t exec --no-startup-id $wm.program.file_search -t $ilia.stylesheet

## Look Selector
set_from_resource $wm.program.look_selector wm.program.look_selector regolith-look-selector
bindsym $mod+Ctrl+Shift+s exec --no-startup-id $wm.program.look_selector -t $ilia.stylesheet

###############################################################################
# Session Management
###############################################################################

bindsym $mod+m  exec i3-input -F 'mark %s' -l 1 -P 'Mark: '
bindsym $mod+apostrophe exec i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Goto: '

## Session // Exit App // <><Shift> q ##
bindsym $mod+Shift+q [con_id="__focused__"] kill

## Session // Terminate App // <><Alt> q ##
bindsym $mod+$alt+q [con_id="__focused__"] exec --no-startup-id kill -9 $(xdotool getwindowfocus getwindowpid)

bindsym $mod+Shift+c reload

set_from_resource $wm.program.refresh_ui wm.program.refresh_ui /usr/bin/regolith-look refresh
bindsym $mod+Shift+r exec --no-startup-id $wm.program.refresh_ui

bindsym $mod+Ctrl+r restart

set_from_resource $wm.program.logout wm.program.logout /usr/bin/gnome-session-quit --logout
bindsym $mod+Shift+e exec $wm.program.logout

set_from_resource $wm.program.reboot wm.program.reboot /usr/bin/gnome-session-quit --reboot
bindsym $mod+Shift+b exec $wm.program.reboot

set_from_resource $wm.program.shutdown wm.program.shutdown /usr/bin/gnome-session-quit --power-off
bindsym $mod+Shift+p exec $wm.program.shutdown

set_from_resource $wm.program.lock wm.program.lock dbus-send --type=method_call --dest=org.gnome.ScreenSaver /org/gnome/ScreenSaver org.gnome.ScreenSaver.Lock
bindsym $mod+Escape exec $wm.program.lock

exec --no-startup-id systemctl --user import-environment XDG_CURRENT_DESKTOP DISPLAY I3SOCK
exec --no-startup-id hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP DISPLAY I3SOCK


bindsym $mod+Shift+s exec systemctl suspend


set_from_resource $wm.program.files wm.program.files /usr/bin/nautilus --new-window
bindsym $mod+Shift+n exec --no-startup-id $wm.program.files
###############################################################################
# i3 Bar
###############################################################################

# Toggle bar visibility
bindsym $mod+i bar mode toggle

set_from_resource $wm.bar.position wm.bar.position bottom
set_from_resource $wm.bar.font gtk.monospace_font_name monospace
set_from_resource $wm.bar.separatorchar wm.bar.separatorchar "("
set_from_resource $wm.bar.trayoutput wm.bar.trayoutput primary
set_from_resource $wm.bar.mode wm.bar.mode dock
set_from_resource $wm.bar.stripworkspacenumbers wm.bar.stripworkspacenumbers yes
set_from_resource $wm.bar.workspace_min_width wm.bar.workspace_min_width 36

# i3xrocks config file. Override this for a custom status bar generator.
set_from_resource $wm.bar.status_command wm.bar.status_command i3xrocks -u ~/.config/regolith2/i3xrocks/conf.d -d /usr/share/i3xrocks/conf.d

# The bar configuration
bar {
  # position $wm.bar.position
  position top
  mode $wm.bar.mode
  font pango:$wm.bar.font
  separator_symbol $wm.bar.separatorchar
  status_command $wm.bar.status_command
  tray_output $wm.bar.trayoutput
  workspace_buttons yes
  strip_workspace_numbers $wm.bar.stripworkspacenumbers
  binding_mode_indicator yes
  workspace_min_width $wm.bar.workspace_min_width

  colors {
        statusline	#999999
        background	#252525
        separator       grey
        #class             border 		backgrd 	text
        focused_workspace  #292929 		#292929 	#cccccc
        # workspace
        active_workspace   #252525 		#252525 	#696f89
        inactive_workspace #252525 		#252525     	#6b6b6b
        urgent_workspace   #252525 		#252525 	#c7a551
        binding_mode       #2f343a              #900000         #ffffff
  }
}

# color setup {{{
# <colorclass> 			<border> 	<background> 	<text> 		<indicator> 	<child_border>
client.focused			#426c82 	#428277	 	#f7f7f7   	#00ff7f
client.unfocused		#426c82 	#000000  	#8C8C8C    	#292d2e
client.focused_inactive         #426c82 	#010000  	#8C8C8C    	#484e50
client.urgent			#426c82 	#383a3b  	#ee0000    	#00ffff
client.placeholder		#426c82 	#444444  	#2DCA12    	#42CA17
client.background 	    	#426c82
#}}}

# Start the installed regolith-compositor
set_from_resource $wm.program.compositor wm.program.compositor /usr/share/regolith-compositor/init
exec_always --no-startup-id $wm.program.compositor
# Hide the mouse pointer if unused for a duration
set_from_resource $wm.program.unclutter wm.program.unclutter /usr/bin/unclutter -b
exec --no-startup-id $wm.program.unclutter
exec --no-startup-id /usr/bin/nm-applet

workspace_layout default
default_orientation horizontal

# dunst
bindsym $mod+ctrl+n exec --no-startup-id dunstctl close
# bindsym $mod+Shift+space exec --no-startup-id dunstctl close-all

set_from_resource $wm.program.media-keys wm.program.media-keys /usr/libexec/gnome-flashback-media-keys
exec --no-startup-id $wm.program.media-keys
# post setup
exec --no-startup-id  ~/.config/regolith3/i3/post_init
exec --no-startup-id  ~/.config/regolith3/i3/scratchpad

