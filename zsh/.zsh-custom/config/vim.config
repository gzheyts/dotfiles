#!/bin/zsh

# Vim XDG Base Directory support
# Patch 9.1.0327+ handles this natively; for older versions we use VIMINIT
if [ -x "$(command -v vim)" ]; then
    if [ "$(vim --clean -es +'exec "!echo" has("patch-9.1.0327")' +q 2>/dev/null)" -eq 0 ]; then
        export VIMINIT="set nocp | source ${XDG_CONFIG_HOME:-$HOME/.config}/vim/vimrc"
    fi
fi
