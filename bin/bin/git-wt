#!/bin/sh
# git-wt <command> [<args>]
# Project-local (.worktrees/) and bare-hub worktree helpers.
#
# Requires: git (>= 2.5 for worktree), find, tar (hub migrate --keep-ignored),
#           a POSIX sh. Optional: set -o pipefail when the shell supports it.

set -eu
# pipefail is not POSIX; enable when available (bash/ksh/etc as /bin/sh).
(set -o pipefail) 2>/dev/null && set -o pipefail

WT_PARENT=.worktrees

usage() {
	cat <<'USAGE'
Usage: git-wt <command> [<args>]

Commands:
  local <subcommand>   Project-local .worktrees/ helpers (day path)
  hub <subcommand>     Bare-hub bootstrap (human multi-branch)
  help                 Show this help

local:
  init                 ensure-ignore + mkdir .worktrees (primary checkout)
  ensure-ignore        ensure .worktrees/ is in local .gitignore (create or append)
  add <name> [-b <branch>] [<start-point>]
  rm <name> [--force] [--branch]
  path <name>          print absolute .worktrees/<name> (fail if missing)
  status               status for trees under .worktrees/ only
  prune [--dry-run] [--force]
                       git worktree prune + orphan cleanup under .worktrees/
  list

hub:
  init <url> [<directory>]
    Clone <url> as a bare hub under <directory> (default: basename of URL),
    then: gitfile -> .bare, fix origin fetch refspec, fetch --all --tags,
    add worktrees for master/develop/dev/main, submodule init in those trees.
  migrate [opts] [<path>]
    In-place convert a clean local clone to bare hub.
    Ignored files: (default) fail | --keep-ignored | --drop-ignored

Hub layout:

  <dir>/.bare/     object store
  <dir>/.git       gitfile: gitdir: ./.bare
  <dir>/<branch>/  worktrees

Local layout (ordinary clone):

  <repo>/
    .git/
    .worktrees/<name>/   linked worktrees
    .gitignore           contains .worktrees/

Deprecated (redirect with warning):
  init … / migrate …   → hub init / hub migrate

Examples:
  git-wt local init
  git-wt local add feat-auth -b feat-auth
  git-wt local path feat-auth
  git-wt local status
  git-wt local list
  git-wt local rm feat-auth --branch
  git-wt local prune --dry-run
  git-wt hub init git@github.com:user/repo.git
  git-wt hub migrate --keep-ignored
  git wt local add feat-auth -b feat-auth
USAGE
}

log() {
	printf 'git-wt: %s\n' "$*" >&2
}

die() {
	printf 'git-wt: error: %s\n' "$*" >&2
	exit 1
}

require_cmd() {
	# Prefer command -v over which (skill: bash-defensive-patterns).
	_cmd=$1
	command -v "$_cmd" >/dev/null 2>&1 || die "required command not found: $_cmd"
}

repo_name_from_url() {
	# Mirror git clone's usual directory guess (basename, strip .git).
	_url=$1
	_url=${_url%/}
	case "$_url" in
	*.git) _url=${_url%.git} ;;
	esac
	_base=${_url##*/}
	# scp-like git@host:path with no slash after colon → take after :
	case "$_base" in
	*:*) _base=${_base##*:} ;;
	esac
	[ -n "$_base" ] || return 1
	printf '%s\n' "$_base"
}

dir_is_empty() {
	# True if directory has no entries (including hidden), except . and ..
	_d=$1
	[ -d "$_d" ] || return 1
	_ents=$(ls -A -- "$_d" 2>/dev/null || true)
	[ -z "$_ents" ]
}

abs_path() {
	CDPATH= cd -- "$1" && pwd
}

# --- local (project-local .worktrees/) ---

require_git_repo() {
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
		|| die "not inside a git work tree"
}

require_primary_checkout() {
	require_git_repo
	_super=$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)
	[ -z "$_super" ] || die "refuse: inside a submodule (run from the superproject primary checkout)"

	_toplevel=$(git rev-parse --show-toplevel) || die "cannot resolve toplevel"
	_cwd=$(pwd -P)
	_top_abs=$(abs_path "$_toplevel")
	[ "$_cwd" = "$_top_abs" ] \
		|| die "refuse: cwd must be the worktree toplevel (got $_cwd, toplevel is $_top_abs)"

	_git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
	_git_common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
	[ "$_git_dir" = "$_git_common" ] \
		|| die "refuse: already in a linked worktree (run from the primary checkout)"
}

# Resolve the checkout that owns .worktrees/ (ordinary primary, or long-lived
# hub tree). From .../.worktrees/<name>, walk up; otherwise use show-toplevel.
resolve_primary_toplevel() {
	require_git_repo
	_top=$(git rev-parse --show-toplevel) || die "cannot resolve toplevel"
	_top_abs=$(abs_path "$_top")
	_parent=$(dirname "$_top_abs")
	_parent_base=$(basename "$_parent")
	if [ "$_parent_base" = "$WT_PARENT" ]; then
		abs_path "$(dirname "$_parent")"
		return 0
	fi
	printf '%s\n' "$_top_abs"
}

validate_local_wt_name() {
	# Flat name only (same rules as local add).
	_n=$1
	case "$_n" in
	*/* | *\\* | .* | "")
		return 1
		;;
	esac
	return 0
}

local_wt_path() {
	# Print $primary/.worktrees/<name> (does not require the directory to exist).
	_n=$1
	validate_local_wt_name "$_n" || die "invalid name '$_n' (flat name only, no slashes)"
	_primary=$(resolve_primary_toplevel) || die "cannot resolve primary toplevel"
	printf '%s\n' "$_primary/$WT_PARENT/$_n"
}

gitignore_has_worktrees() {
	# True if local .gitignore already lists .worktrees or .worktrees/ (line-level).
	# Does not consult global excludes or $GIT_DIR/info/exclude.
	_gi=$1
	[ -f "$_gi" ] || return 1
	# Optional trailing comment; ignore blank-only lines.
	grep -Eq '^[[:space:]]*\.worktrees(/)?([[:space:]]*(#.*)?)?$' "$_gi"
}

local_ensure_ignore() {
	require_git_repo
	_toplevel=$(git rev-parse --show-toplevel) || die "cannot resolve toplevel"
	_gi=$_toplevel/.gitignore
	_entry="$WT_PARENT/"

	if gitignore_has_worktrees "$_gi"; then
		log "$_entry already in .gitignore"
		return 0
	fi

	if [ -f "$_gi" ]; then
		log "append $_entry to .gitignore"
		if [ -s "$_gi" ]; then
			_last=$(tail -c 1 "$_gi" | od -An -tx1 | tr -d ' \n' || true)
			# 0a = newline; append one if the file does not end with it
			[ "$_last" = "0a" ] || printf '\n' >>"$_gi"
		fi
		printf '%s\n' "$_entry" >>"$_gi" || die "cannot append to $_gi"
	else
		log "create .gitignore with $_entry"
		printf '%s\n' "$_entry" >"$_gi" || die "cannot create $_gi"
	fi

	gitignore_has_worktrees "$_gi" \
		|| die "failed to record $_entry in .gitignore"
}

cmd_local_init() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		-*)
			die "local init: unknown option: $1"
			;;
		*)
			die "local init: unexpected argument: $1"
			;;
		esac
	done

	require_primary_checkout
	local_ensure_ignore
	_toplevel=$(git rev-parse --show-toplevel)
	mkdir -p -- "$_toplevel/$WT_PARENT" || die "cannot create $_toplevel/$WT_PARENT"
	log "ready: $_toplevel/$WT_PARENT"
	printf '%s\n' "$_toplevel/$WT_PARENT"
}

cmd_local_ensure_ignore() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		*)
			die "local ensure-ignore: unexpected argument: $1"
			;;
		esac
	done
	local_ensure_ignore
}

cmd_local_add() {
	_name=""
	_branch=""
	_start=""
	_has_b=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		-b)
			[ $# -ge 2 ] || die "local add: -b requires a branch name"
			_branch=$2
			_has_b=1
			shift 2
			continue
			;;
		--)
			shift
			break
			;;
		-*)
			die "local add: unknown option: $1"
			;;
		*)
			if [ -z "$_name" ]; then
				_name=$1
			elif [ -z "$_start" ]; then
				_start=$1
			else
				die "local add: unexpected argument: $1"
			fi
			shift
			continue
			;;
		esac
		shift
	done

	while [ $# -gt 0 ]; do
		if [ -z "$_name" ]; then
			_name=$1
		elif [ -z "$_start" ]; then
			_start=$1
		else
			die "local add: unexpected argument: $1"
		fi
		shift
	done

	[ -n "$_name" ] || die "local add: missing <name> (try: git-wt help)"
	case "$_name" in
	*/* | *\\* | .* | "")
		die "local add: invalid name '$_name' (flat name only, no slashes)"
		;;
	esac

	require_primary_checkout
	local_ensure_ignore

	_toplevel=$(git rev-parse --show-toplevel)
	_path=$_toplevel/$WT_PARENT/$_name
	[ ! -e "$_path" ] || die "local add: path already exists: $_path"

	# Never touch remote.* — ordinary clone remotes stay as-is.
	if [ "$_has_b" -eq 1 ]; then
		[ -n "$_branch" ] || die "local add: empty -b branch"
		if [ -n "$_start" ]; then
			log "worktree add -b $_branch $WT_PARENT/$_name $_start"
			git -C "$_toplevel" worktree add -b "$_branch" "$_path" "$_start" \
				|| die "worktree add failed"
		else
			log "worktree add -b $_branch $WT_PARENT/$_name"
			git -C "$_toplevel" worktree add -b "$_branch" "$_path" \
				|| die "worktree add failed"
		fi
	else
		if [ -n "$_start" ]; then
			log "worktree add $WT_PARENT/$_name $_start"
			git -C "$_toplevel" worktree add "$_path" "$_start" \
				|| die "worktree add failed"
		else
			log "worktree add $WT_PARENT/$_name (new branch $_name)"
			git -C "$_toplevel" worktree add -b "$_name" "$_path" \
				|| die "worktree add failed"
		fi
	fi

	printf '%s\n' "$_path"
}

cmd_local_rm() {
	_name=""
	_force=0
	_branch_flag=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--force | -f)
			_force=1
			shift
			continue
			;;
		--branch)
			_branch_flag=1
			shift
			continue
			;;
		-*)
			die "local rm: unknown option: $1"
			;;
		*)
			[ -z "$_name" ] || die "local rm: unexpected argument: $1"
			_name=$1
			shift
			continue
			;;
		esac
		shift
	done

	[ -n "$_name" ] || die "local rm: missing <name> (try: git-wt help)"
	validate_local_wt_name "$_name" \
		|| die "local rm: invalid name '$_name' (flat name only)"

	require_primary_checkout
	_toplevel=$(git rev-parse --show-toplevel)
	_path=$_toplevel/$WT_PARENT/$_name

	_br=""
	if [ "$_branch_flag" -eq 1 ] && [ -d "$_path" ]; then
		_br=$(git -C "$_path" symbolic-ref -q --short HEAD 2>/dev/null || true)
	fi

	if [ "$_force" -eq 1 ]; then
		log "worktree remove --force $WT_PARENT/$_name"
		git -C "$_toplevel" worktree remove --force -- "$_path" \
			|| die "worktree remove failed"
	else
		log "worktree remove $WT_PARENT/$_name"
		git -C "$_toplevel" worktree remove -- "$_path" \
			|| die "worktree remove failed"
	fi

	if [ "$_branch_flag" -eq 1 ]; then
		if [ -z "$_br" ]; then
			log "rm --branch: skip (detached HEAD or no branch recorded)"
		elif [ "$_force" -eq 1 ]; then
			log "branch -D $_br"
			git -C "$_toplevel" branch -D -- "$_br" \
				|| die "branch -D failed for $_br"
		else
			log "branch -d $_br"
			git -C "$_toplevel" branch -d -- "$_br" \
				|| die "branch -d failed for $_br"
		fi
	fi
}

cmd_local_path() {
	_name=""

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		-*)
			die "local path: unknown option: $1"
			;;
		*)
			[ -z "$_name" ] || die "local path: unexpected argument: $1"
			_name=$1
			shift
			continue
			;;
		esac
		shift
	done

	[ -n "$_name" ] || die "local path: missing <name> (try: git-wt help)"
	_path=$(local_wt_path "$_name") || exit 1
	[ -d "$_path" ] || die "local path: not found: $_path"
	printf '%s\n' "$_path"
}

cmd_local_status() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		*)
			die "local status: unexpected argument: $1"
			;;
		esac
	done

	require_git_repo
	_primary=$(resolve_primary_toplevel) || die "cannot resolve primary toplevel"
	_prefix=$_primary/$WT_PARENT
	_prefix_slash=$_prefix/

	# Collect registered worktrees under .worktrees/ from porcelain.
	_paths=""
	_cur=""
	while IFS= read -r _line || [ -n "$_line" ]; do
		case "$_line" in
		worktree\ *)
			_cur=${_line#worktree }
			_cur_abs=$(abs_path "$_cur" 2>/dev/null || printf '%s\n' "$_cur")
			case "$_cur_abs" in
			"$_prefix_slash"*)
				if [ -z "$_paths" ]; then
					_paths=$_cur_abs
				else
					_paths=$(printf '%s\n%s\n' "$_paths" "$_cur_abs")
				fi
				;;
			esac
			;;
		esac
	done <<EOF
$(git worktree list --porcelain)
EOF

	printf '%-20s %-24s %-5s %5s %6s\n' NAME BRANCH DIRTY AHEAD BEHIND
	if [ -z "$_paths" ]; then
		return 0
	fi

	printf '%s\n' "$_paths" | while IFS= read -r _wt || [ -n "$_wt" ]; do
		[ -n "$_wt" ] || continue
		_name=$(basename "$_wt")
		_br=$(git -C "$_wt" symbolic-ref -q --short HEAD 2>/dev/null || true)
		if [ -z "$_br" ]; then
			_sha=$(git -C "$_wt" rev-parse --short HEAD 2>/dev/null || printf '?')
			_br="detached@$_sha"
		fi
		_dirty="-"
		_porc=$(git -C "$_wt" status --porcelain 2>/dev/null || true)
		[ -z "$_porc" ] || _dirty="*"

		_ahead="-"
		_behind="-"
		_counts=$(git -C "$_wt" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || true)
		if [ -n "$_counts" ]; then
			# shellcheck disable=SC2086
			set -- $_counts
			_behind=$1
			_ahead=$2
		fi

		printf '%-20s %-24s %-5s %5s %6s\n' "$_name" "$_br" "$_dirty" "$_ahead" "$_behind"
	done
}

cmd_local_prune() {
	_dry=0
	_force=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--dry-run)
			_dry=1
			shift
			continue
			;;
		--force | -f)
			_force=1
			shift
			continue
			;;
		-*)
			die "local prune: unknown option: $1"
			;;
		*)
			die "local prune: unexpected argument: $1"
			;;
		esac
		shift
	done

	require_primary_checkout
	_toplevel=$(git rev-parse --show-toplevel)
	_parent=$_toplevel/$WT_PARENT

	if [ "$_dry" -eq 1 ]; then
		log "worktree prune --dry-run"
		git -C "$_toplevel" worktree prune --dry-run \
			|| die "worktree prune --dry-run failed"
	else
		log "worktree prune"
		git -C "$_toplevel" worktree prune \
			|| die "worktree prune failed"
	fi

	[ -d "$_parent" ] || return 0

	# Registered absolute paths (any worktree), for orphan detection.
	_registered=$(
		git -C "$_toplevel" worktree list --porcelain | while IFS= read -r _line; do
			case "$_line" in
			worktree\ *)
				_p=${_line#worktree }
				abs_path "$_p" 2>/dev/null || printf '%s\n' "$_p"
				;;
			esac
		done
	)

	# Word-split-safe: iterate directory entries via find -print0 would need
	# non-POSIX; names are flat (no spaces expected from local add). Use ls -A.
	_ents=$(ls -A -- "$_parent" 2>/dev/null || true)
	[ -n "$_ents" ] || return 0

	for _ent in $_ents; do
		_cand=$_parent/$_ent
		[ -e "$_cand" ] || continue
		_cand_abs=$(abs_path "$_cand" 2>/dev/null || printf '%s\n' "$_cand")

		_is_reg=0
		# Compare against registered list line-by-line
		while IFS= read -r _reg || [ -n "$_reg" ]; do
			[ -n "$_reg" ] || continue
			if [ "$_reg" = "$_cand_abs" ]; then
				_is_reg=1
				break
			fi
		done <<EOF
$_registered
EOF

		[ "$_is_reg" -eq 0 ] || continue

		if [ ! -d "$_cand_abs" ]; then
			log "orphan (not a directory), skip: $WT_PARENT/$_ent"
			continue
		fi

		# Empty? (no entries except . / ..)
		_child=$(ls -A -- "$_cand_abs" 2>/dev/null || true)
		if [ -z "$_child" ]; then
			if [ "$_dry" -eq 1 ]; then
				log "dry-run: would rmdir orphan $WT_PARENT/$_ent"
			else
				log "rmdir orphan $WT_PARENT/$_ent"
				rmdir -- "$_cand_abs" || die "rmdir failed: $_cand_abs"
			fi
			continue
		fi

		if [ "$_force" -eq 1 ]; then
			if [ "$_dry" -eq 1 ]; then
				log "dry-run: would rm -rf orphan $WT_PARENT/$_ent"
			else
				log "rm -rf orphan $WT_PARENT/$_ent"
				rm -rf -- "$_cand_abs" || die "rm -rf failed: $_cand_abs"
			fi
		else
			log "orphan non-empty (pass --force to remove): $WT_PARENT/$_ent"
		fi
	done
}

cmd_local_list() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		*)
			die "local list: unexpected argument: $1"
			;;
		esac
	done
	require_git_repo
	git worktree list
}

cmd_local() {
	[ $# -gt 0 ] || die "local: missing subcommand (try: git-wt help)"
	_sub=$1
	shift
	case "$_sub" in
	init)
		cmd_local_init "$@"
		;;
	ensure-ignore)
		cmd_local_ensure_ignore "$@"
		;;
	add)
		cmd_local_add "$@"
		;;
	rm | remove)
		cmd_local_rm "$@"
		;;
	path)
		cmd_local_path "$@"
		;;
	status)
		cmd_local_status "$@"
		;;
	prune)
		cmd_local_prune "$@"
		;;
	list)
		cmd_local_list "$@"
		;;
	help | -h | --help)
		usage
		exit 0
		;;
	*)
		die "local: unknown subcommand: $_sub (try: git-wt help)"
		;;
	esac
}

# --- hub (bare hub) ---

branch_exists() {
	_hub=$1
	_b=$2
	git -C "$_hub" show-ref --verify --quiet "refs/heads/$_b" \
		|| git -C "$_hub" show-ref --verify --quiet "refs/remotes/origin/$_b"
}

has_gitmodules() {
	_hub=$1
	git -C "$_hub" rev-parse --verify --quiet HEAD >/dev/null 2>&1 \
		&& git -C "$_hub" cat-file -e HEAD:.gitmodules 2>/dev/null
}

track_origin_if_present() {
	_hub=$1
	_b=$2
	if git -C "$_hub" show-ref --verify --quiet "refs/remotes/origin/$_b"; then
		log "upstream $_b -> origin/$_b"
		git -C "$_hub" branch --set-upstream-to="origin/$_b" "$_b" \
			|| die "failed to set upstream for $_b"
	else
		log "no origin/$_b; leave $_b without upstream"
	fi
}

add_worktree() {
	_hub=$1
	_b=$2
	if git -C "$_hub" show-ref --verify --quiet "refs/heads/$_b"; then
		log "worktree add $_b (local refs/heads/$_b)"
		git -C "$_hub" worktree add "$_b" "$_b" || die "worktree add failed for $_b"
	else
		log "worktree add $_b (create from origin/$_b)"
		git -C "$_hub" worktree add -b "$_b" "$_b" "origin/$_b" \
			|| die "worktree add failed for $_b (from origin/$_b)"
	fi
	track_origin_if_present "$_hub" "$_b"
}

hub_fix_fetch() {
	_hub=$1
	if git -C "$_hub" remote get-url origin >/dev/null 2>&1; then
		log "fix origin fetch refspec (bare blind-clone trap)"
		git -C "$_hub" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
	else
		log "no origin remote; skip fetch refspec fix"
	fi

	if [ -n "$(git -C "$_hub" remote 2>/dev/null || true)" ]; then
		log "git fetch --all --tags"
		git -C "$_hub" fetch --all --tags || die "git fetch --all --tags failed"
	else
		log "no remotes; skip fetch"
	fi
}

hub_cleanup_bootstrap() {
	_hub=$1
	if [ -d "$_hub/.wtree-bootstrap" ]; then
		log "cleanup: removing leftover .wtree-bootstrap"
		git -C "$_hub" worktree remove -f "$_hub/.wtree-bootstrap" 2>/dev/null || true
		rm -rf -- "$_hub/.wtree-bootstrap" 2>/dev/null || true
	fi
}

hub_submodule_update() {
	_hub=$1
	_path=$2
	log "submodule update --init --recursive in $_path/"
	git -C "$_hub/$_path" submodule update --init --recursive \
		|| die "submodule update failed in $_path"
}

hub_warm_submodules_or_bootstrap() {
	_hub=$1
	_first=$2

	if [ -n "$_first" ]; then
		log "created worktrees; first: $_first (modules warmed there)"
		return 0
	fi

	if has_gitmodules "$_hub"; then
		log "no worktrees; HEAD has .gitmodules — temp bootstrap worktree"
		# shellcheck disable=SC2064
		trap "hub_cleanup_bootstrap \"$_hub\"" EXIT INT TERM
		log "worktree add --detach .wtree-bootstrap"
		git -C "$_hub" worktree add --detach "$_hub/.wtree-bootstrap" HEAD \
			|| die "bootstrap worktree add failed"
		log "submodule update --init --recursive in .wtree-bootstrap"
		git -C "$_hub/.wtree-bootstrap" submodule update --init --recursive \
			|| die "submodule update failed in bootstrap worktree"
		log "worktree remove -f .wtree-bootstrap"
		git -C "$_hub" worktree remove -f "$_hub/.wtree-bootstrap" \
			|| die "bootstrap worktree remove failed"
		trap - EXIT INT TERM
		log "bootstrap done; modules under .bare/modules/"
	else
		log "no worktrees and no .gitmodules — nothing to warm"
	fi
}

hub_worktrees_fixed() {
	_hub=$1
	_first=""
	log "long-lived worktrees (master develop dev main)"
	for b in master develop dev main; do
		if branch_exists "$_hub" "$b"; then
			add_worktree "$_hub" "$b" || die "worktree add failed for $b"
			hub_submodule_update "$_hub" "$b"
			[ -n "$_first" ] || _first=$b
		else
			log "skip branch $b (not in refs/heads or refs/remotes/origin)"
		fi
	done
	hub_warm_submodules_or_bootstrap "$_hub" "$_first"
}

hub_worktrees_all_local() {
	_hub=$1
	_first=""
	log "worktrees for all local branches (refs/heads/*)"
	_branches=$(git -C "$_hub" for-each-ref --format='%(refname:short)' refs/heads/)
	if [ -z "$_branches" ]; then
		log "no local branches"
		hub_warm_submodules_or_bootstrap "$_hub" ""
		return 0
	fi
	# Word-split is intentional: git branch names cannot contain IFS whitespace
	# or newlines; a pipeline `while read` would run in a subshell and lose _first.
	for b in $_branches; do
		case "$b" in
		.bare | .git | .wtree-bootstrap | .wt-keep)
			die "refusing worktree for reserved branch name: $b"
			;;
		esac
		log "worktree add $b (local refs/heads/$b)"
		git -C "$_hub" worktree add "$b" "$b" || die "worktree add failed for $b"
		track_origin_if_present "$_hub" "$b"
		hub_submodule_update "$_hub" "$b"
		[ -n "$_first" ] || _first=$b
	done
	hub_warm_submodules_or_bootstrap "$_hub" "$_first"
}

hub_done() {
	_hub=$1
	log "done"
	printf '\nHub ready: %s\n' "$_hub"
	git -C "$_hub" worktree list
	printf '\nNext (examples):\n'
	printf '  cd %s/<long-lived-branch>\n' "$_hub"
	printf '  git-wt local init    # if you want .worktrees under that checkout\n'
	printf '  git worktree add feature/x -b feature/x develop   # hub sibling\n'
}

migrate_park_ignored() {
	_hub=$1
	_list=$2
	_keep=$_hub/.wt-keep

	require_cmd tar
	log "migrate: parking ignored paths under .wt-keep/"
	rm -rf -- "$_keep"
	mkdir -- "$_keep" || die "migrate: cannot create $_keep"
	# Preserve relative paths via tar file list
	printf '%s\n' "$_list" | tar -C "$_hub" -T - -cf - | tar -C "$_keep" -xf - \
		|| die "migrate: failed to park ignored files"

	_mib=$(du -sm -- "$_keep" 2>/dev/null | awk '{print $1}')
	if [ -n "$_mib" ] && [ "$_mib" -ge 50 ]; then
		log "warning: parked ignored payload is ${_mib}MiB (>= 50MiB)"
	fi
}

migrate_restore_ignored() {
	_hub=$1
	_branch=$2
	_keep=$_hub/.wt-keep
	_dest=$_hub/$_branch

	[ -d "$_keep" ] || return 0
	[ -d "$_dest" ] || die "migrate: restore target worktree missing: $_dest"
	log "migrate: restoring ignored paths into $_branch/"
	tar -C "$_keep" -cf - . | tar -C "$_dest" -xf - \
		|| die "migrate: failed to restore ignored files into $_branch"
	rm -rf -- "$_keep"
	log "migrate: restored ignored files; removed .wt-keep"
}

cmd_hub_init() {
	url=""
	directory=""
	has_url=0
	has_dir=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--)
			shift
			break
			;;
		-*)
			die "hub init: unknown option: $1"
			;;
		*)
			if [ "$has_url" -eq 0 ]; then
				url=$1
				has_url=1
			elif [ "$has_dir" -eq 0 ]; then
				directory=$1
				has_dir=1
			else
				die "hub init: unexpected argument: $1"
			fi
			shift
			continue
			;;
		esac
		shift
	done

	while [ $# -gt 0 ]; do
		if [ "$has_url" -eq 0 ]; then
			url=$1
			has_url=1
		elif [ "$has_dir" -eq 0 ]; then
			directory=$1
			has_dir=1
		else
			die "hub init: unexpected argument: $1"
		fi
		shift
	done

	[ "$has_url" -eq 1 ] || die "hub init: missing <url> (try: git-wt help)"

	if [ "$has_dir" -eq 0 ]; then
		directory=$(repo_name_from_url "$url") || die "cannot derive directory name from URL"
		log "directory not given; using basename from URL: $directory"
	else
		log "directory: $directory"
	fi

	case "$directory" in
	"" | . | ..) die "invalid directory: $directory" ;;
	esac

	log "url: $url"

	if [ -e "$directory" ]; then
		[ -d "$directory" ] || die "not a directory: $directory"
		dir_is_empty "$directory" || die "destination path '$directory' already exists and is not an empty directory"
		log "using existing empty directory: $directory"
	else
		log "mkdir $directory"
		mkdir -- "$directory"
	fi

	hub=$(abs_path "$directory") || die "cannot enter $directory"
	log "hub: $hub"

	log "step: git clone --bare -> $hub/.bare"
	git clone --bare -- "$url" "$hub/.bare" || die "git clone --bare failed"

	log "step: write gitfile $hub/.git -> ./.bare"
	printf 'gitdir: ./.bare\n' >"$hub/.git"

	hub_fix_fetch "$hub"
	hub_worktrees_fixed "$hub"
	hub_done "$hub"
}

cmd_hub_migrate() {
	path="."
	has_path=0
	keep_ignored=0
	drop_ignored=0

	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--keep-ignored)
			keep_ignored=1
			shift
			continue
			;;
		--drop-ignored)
			drop_ignored=1
			shift
			continue
			;;
		--)
			shift
			break
			;;
		-*)
			die "hub migrate: unknown option: $1"
			;;
		*)
			if [ "$has_path" -eq 1 ]; then
				die "hub migrate: unexpected argument: $1"
			fi
			path=$1
			has_path=1
			shift
			continue
			;;
		esac
		shift
	done

	while [ $# -gt 0 ]; do
		if [ "$has_path" -eq 1 ]; then
			die "hub migrate: unexpected argument: $1"
		fi
		path=$1
		has_path=1
		shift
	done

	if [ "$keep_ignored" -eq 1 ] && [ "$drop_ignored" -eq 1 ]; then
		die "hub migrate: --keep-ignored and --drop-ignored are mutually exclusive"
	fi

	[ -e "$path" ] || die "hub migrate: path does not exist: $path"
	[ -d "$path" ] || die "hub migrate: not a directory: $path"

	hub=$(abs_path "$path") || die "hub migrate: cannot enter $path"
	log "migrate: path $hub"

	git -C "$hub" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
		|| die "hub migrate: not a git work tree: $hub"

	toplevel=$(git -C "$hub" rev-parse --show-toplevel) || die "hub migrate: cannot resolve toplevel"
	toplevel=$(abs_path "$toplevel")
	[ "$hub" = "$toplevel" ] || die "hub migrate: path must be the worktree toplevel (got $hub, toplevel is $toplevel)"

	bare=$(git -C "$hub" rev-parse --is-bare-repository) || die "hub migrate: rev-parse failed"
	[ "$bare" = "false" ] || die "hub migrate: repository is already bare"

	[ -d "$hub/.git" ] || die "hub migrate: .git is not a directory (already a gitfile/hub/linked worktree?)"
	[ ! -e "$hub/.bare" ] || die "hub migrate: $hub/.bare already exists"

	common=$(git -C "$hub" rev-parse --git-common-dir) || die "hub migrate: cannot resolve git-common-dir"
	case "$common" in
	/*) common_abs=$common ;;
	*) common_abs=$(CDPATH= cd -- "$hub" && CDPATH= cd -- "$common" && pwd) ;;
	esac
	expected_git=$(abs_path "$hub/.git")
	[ "$common_abs" = "$expected_git" ] || die "hub migrate: not the main worktree (git-common-dir=$common_abs)"

	porcelain=$(git -C "$hub" status --porcelain)
	if [ -n "$porcelain" ]; then
		printf '%s\n' "git-wt: error: hub migrate: working tree is not clean (commit/stash/clean first):" >&2
		printf '%s\n' "$porcelain" >&2
		exit 1
	fi
	log "migrate: working tree clean"

	ignored=$(git -C "$hub" ls-files -o -i --exclude-standard || true)
	head_branch=""
	do_keep=0

	if [ -n "$ignored" ]; then
		if [ "$keep_ignored" -eq 1 ]; then
			head_branch=$(git -C "$hub" symbolic-ref -q --short HEAD) \
				|| die "hub migrate: --keep-ignored requires a checked-out branch (not detached); checkout a branch or use --drop-ignored"
			log "migrate: --keep-ignored (restore into $head_branch/)"
			printf '%s\n' "$ignored" | while IFS= read -r _p; do
				[ -n "$_p" ] || continue
				log "  keep: $_p"
			done
			migrate_park_ignored "$hub" "$ignored"
			do_keep=1
		elif [ "$drop_ignored" -eq 1 ]; then
			log "migrate: --drop-ignored (ignored paths will be deleted)"
			printf '%s\n' "$ignored" | while IFS= read -r _p; do
				[ -n "$_p" ] || continue
				log "  drop: $_p"
			done
		else
			printf '%s\n' "git-wt: error: hub migrate: ignored files present; pass --keep-ignored or --drop-ignored:" >&2
			printf '%s\n' "$ignored" >&2
			exit 1
		fi
	else
		log "migrate: no ignored files"
	fi

	# git clone --bare from a local path sets origin to that path; keep the
	# external URL (and distinct push URL, if any) from the pre-migrate repo.
	origin_url=""
	origin_push=""
	has_origin=0
	if git -C "$hub" remote get-url origin >/dev/null 2>&1; then
		has_origin=1
		origin_url=$(git -C "$hub" remote get-url origin)
		origin_push=$(git -C "$hub" remote get-url --push origin)
		[ -n "$origin_url" ] || die "hub migrate: origin URL is empty"
		[ -n "$origin_push" ] || die "hub migrate: origin push URL is empty"
		log "migrate: remembered origin $origin_url"
		if [ "$origin_push" != "$origin_url" ]; then
			log "migrate: remembered origin (push) $origin_push"
		fi
	else
		log "migrate: no origin remote before migrate"
	fi

	log "migrate: git clone --bare $hub/.git -> $hub/.bare"
	git clone --bare -- "$hub/.git" "$hub/.bare" || die "hub migrate: git clone --bare failed"

	# Verify bare before deleting the old .git (fail closed; leave original intact).
	_bare_flag=$(git -C "$hub/.bare" rev-parse --is-bare-repository 2>/dev/null || true)
	[ "$_bare_flag" = "true" ] || die "hub migrate: $hub/.bare is not a bare repository; refusing to remove .git"

	if [ "$has_origin" -eq 1 ]; then
		log "migrate: set origin url -> $origin_url"
		git -C "$hub/.bare" remote set-url origin -- "$origin_url" \
			|| die "hub migrate: failed to set origin url"
		if [ "$origin_push" != "$origin_url" ]; then
			log "migrate: set origin pushurl -> $origin_push"
			git -C "$hub/.bare" remote set-url --push origin -- "$origin_push" \
				|| die "hub migrate: failed to set origin pushurl"
		fi
		_check_url=$(git -C "$hub/.bare" remote get-url origin)
		[ "$_check_url" = "$origin_url" ] \
			|| die "hub migrate: origin URL mismatch after set-url (got: $_check_url)"
	else
		log "migrate: remove clone-created origin (local path)"
		git -C "$hub/.bare" remote remove origin 2>/dev/null || true
	fi

	log "migrate: remove old $hub/.git directory"
	rm -rf -- "$hub/.git"

	log "migrate: write gitfile $hub/.git -> ./.bare"
	printf 'gitdir: ./.bare\n' >"$hub/.git"

	log "migrate: remove old working-tree files from hub root"
	if [ "$do_keep" -eq 1 ]; then
		find "$hub" -mindepth 1 -maxdepth 1 ! -name .bare ! -name .git ! -name .wt-keep -exec rm -rf {} +
	else
		find "$hub" -mindepth 1 -maxdepth 1 ! -name .bare ! -name .git -exec rm -rf {} +
	fi

	hub_fix_fetch "$hub"
	hub_worktrees_all_local "$hub"

	if [ "$do_keep" -eq 1 ]; then
		migrate_restore_ignored "$hub" "$head_branch"
	fi

	hub_done "$hub"
}

cmd_hub() {
	[ $# -gt 0 ] || die "hub: missing subcommand (try: git-wt help)"
	_sub=$1
	shift
	case "$_sub" in
	init)
		cmd_hub_init "$@"
		;;
	migrate)
		require_cmd find
		for _a in "$@"; do
			case "$_a" in
			--keep-ignored) require_cmd tar; break ;;
			esac
		done
		cmd_hub_migrate "$@"
		;;
	help | -h | --help)
		usage
		exit 0
		;;
	*)
		die "hub: unknown subcommand: $_sub (try: git-wt help)"
		;;
	esac
}

cmd_help() {
	usage
}

warn_deprecated_hub() {
	_old=$1
	log "warning: 'git-wt $_old' is deprecated; use 'git-wt hub $_old' instead"
}

# --- dispatch ---

if [ $# -eq 0 ]; then
	usage >&2
	exit 1
fi

cmd=$1
shift

case "$cmd" in
help | -h | --help)
	cmd_help
	exit 0
	;;
esac

require_cmd git

case "$cmd" in
local)
	cmd_local "$@"
	;;
hub)
	cmd_hub "$@"
	;;
init)
	warn_deprecated_hub init
	cmd_hub_init "$@"
	;;
migrate)
	warn_deprecated_hub migrate
	require_cmd find
	for _a in "$@"; do
		case "$_a" in
		--keep-ignored) require_cmd tar; break ;;
		esac
	done
	cmd_hub_migrate "$@"
	;;
*)
	die "unknown command: $cmd (try: git-wt help)"
	;;
esac
