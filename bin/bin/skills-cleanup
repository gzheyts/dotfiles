#!/bin/sh
# =============================================================================
# skills_cleanup - Remove unneeded skills for Java/Spring backend developer
# =============================================================================
# KEEP skills related to: Java, SQL, Linux, DB performance, Backend architecture,
# Microservices, Architecture design, Software testing, Refactoring, Active Directory,
# Oracle, LDAP, Clean code, Confluence, Web dev (HTTP/protocols), Optimizations,
# Docker/K8s/GitLab, Research/Prompt planning, Security (Java/Web), Algorithms
#
# REMOVE: Microsoft, LLM/AI development, Non-Java backend, Mobile, Jira,
# AI tools, Web frameworks (non-Java)

SKILLS_DIR="${1:-$HOME/.config/opencode/skills/skills}"

if [ ! -d "$SKILLS_DIR" ]; then
    echo "Error: directory does not exist: $SKILLS_DIR" >&2
    exit 1
fi

echo "Skills Cleanup - removing non-relevant skills"
echo "Target: $SKILLS_DIR"
echo ""

REMOVED=0
SKIPPED=0

remove_skill() {
    if [ -d "$SKILLS_DIR/$1" ]; then
        rm -rf "$SKILLS_DIR/$1" 2>/dev/null && echo "[REMOVED] $1" && REMOVED=$((REMOVED+1)) || echo "[FAILED] $1"
    else
        echo "[SKIPPED] $1 (not found)" && SKIPPED=$((SKIPPED+1))
    fi
}

