#!/usr/bin/env zsh
# Cursor agent shell integration, cached and lazy-loaded.
#
# The agent binary emits a mostly-static script that costs ~1.6s to produce,
# so we cache it and regenerate only when the binary changes. The chat-id
# creation (also ~1.7s) is deferred until the integration is actually used.

_cursor_agent_bin=$HOME/.local/bin/agent

_cursor_agent_transform() {
  python3 -c '
import sys
s = sys.stdin.read()
s = s.replace(
    "--resume $CURSOR_AGENT_CHAT_ID",
    "--resume \"$(_cursor_agent_chat_id)\"",
)
block = """# Create a new chat session at the start of each shell session
if [[ -z \"$CURSOR_AGENT_CHAT_ID\" ]]; then
  export CURSOR_AGENT_CHAT_ID=$(command agent create-chat)
fi"""
lazy = """# Chat id is created lazily, on the first real use of the integration
_cursor_agent_chat_id() {
  if [[ -z \"$CURSOR_AGENT_CHAT_ID\" ]]; then
    CURSOR_AGENT_CHAT_ID=$(command agent create-chat)
    export CURSOR_AGENT_CHAT_ID
  fi
  print -rn -- \"$CURSOR_AGENT_CHAT_ID\"
}"""
sys.stdout.write(s.replace(block, lazy))
'
}

_cursor_agent_init() {
  local cache=$HOME/.cache/zsh/cursor-agent.zsh
  if [[ ! -f $cache ]] || [[ $_cursor_agent_bin -nt $cache ]]; then
    mkdir -p ${cache:h}
    local raw
    raw=$($_cursor_agent_bin shell-integration zsh 2>/dev/null) || raw=
    if [[ -n $raw ]]; then
      print -r -- "$raw" >| $cache
      print -r -- "$raw" | _cursor_agent_transform 2>/dev/null >| $cache.tmp
      if [[ -s $cache.tmp ]]; then
        mv $cache.tmp $cache
      else
        rm -f $cache.tmp
      fi
    fi
  fi
  [[ -f $cache ]] && source $cache
}