#!/bin/sh

# Yandex Code Assistant -  launch OpenCode
alias ysc='ysc-wrapper'
alias yscc='ysc -- --continue'

alias ysch='ysc --help'
alias yscd='ysc -- debug'

alias ysci='ysc install'

alias yscq='src quota'
alias yscu='src update'

alias yscuc='src update --check'

alias ysd='src do'
alias yss='src skill'
