#!/bin/zsh

# Set pane title to current command before execution (with recursive alias expansion)
_tmux_title_pid=0

function _tmux_set_pane_title() {
  [[ -z "$TMUX" ]] && return
  local cmd="$1"
  local first expanded
  local -a seen

  while true; do
    first="${cmd%% *}"
    expanded="${aliases[$first]}"
    [[ -z "$expanded" || "${seen[(r)$first]}" == "$first" ]] && break
    seen+=("$first")
    cmd="${expanded}${cmd#$first}"
  done

  # set title after delay — cancelled if command finishes fast
  { sleep 0.5 && printf '\033]2;%s\007' "$cmd" } &!
  _tmux_title_pid=$!
}
preexec_functions+=(_tmux_set_pane_title)

# Reset pane title to "zsh" when back at prompt
function _tmux_reset_pane_title() {
  [[ -z "$TMUX" ]] && return
  [[ $_tmux_title_pid -ne 0 ]] && kill $_tmux_title_pid 2>/dev/null
  _tmux_title_pid=0
  printf '\033]2;%s\007' "${PWD/#$HOME/~}"
}
precmd_functions+=(_tmux_reset_pane_title)
